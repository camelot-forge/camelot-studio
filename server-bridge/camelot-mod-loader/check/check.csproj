<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>disable</Nullable>
    <LangVersion>latest</LangVersion>
    <AssemblyName>CamelotModLoaderCheck</AssemblyName>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <NoWarn>CS0618;CS8632</NoWarn>
    <WarningLevel>2</WarningLevel>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../ModPack.cs" />
    <Compile Include="../ModStore.cs" />
    <Compile Include="../CamelotModLoader.cs" />
  </ItemGroup>
  <ItemGroup>
    <Reference Include="all-release"><HintPath>$(DaocServerRelease)/GameServer.dll</HintPath></Reference>
    <Reference Include="CoreBase"><HintPath>$(DaocServerRelease)/CoreBase.dll</HintPath></Reference>
    <Reference Include="CoreDatabase"><HintPath>$(DaocServerRelease)/CoreDatabase.dll</HintPath></Reference>
    <Reference Include="Newtonsoft.Json"><HintPath>$(DaocServerRelease)/Newtonsoft.Json.dll</HintPath></Reference>
    <Reference Include="ICSharpCode.SharpZipLib"><HintPath>$(DaocServerRelease)/ICSharpCode.SharpZipLib.dll</HintPath></Reference>
    <Reference Include="CoreServer"><HintPath>$(DaocServerRelease)/CoreServer.dll</HintPath></Reference>
    <Reference Include="GameServerScripts"><HintPath>$(DaocServerRelease)/lib/GameServerScripts.dll</HintPath></Reference>
  </ItemGroup>
</Project>
