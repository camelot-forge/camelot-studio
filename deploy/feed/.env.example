# The public URL players will read. Local examples use the host mapping; online,
# put a TLS reverse proxy in front and use its public name here.
CAMELOT_FEED_URL=http://127.0.0.1:8080/

# The game's address, host:port. It is written into the feed's launcher.json.
CAMELOT_GAME_SERVER=127.0.0.1:10300

# The operator's published feed directory, on this machine.
CAMELOT_FEED_SOURCE=/path/to/project/feed

# The host port; the service listens on 8080 inside the container.
CAMELOT_FEED_PORT=8080
