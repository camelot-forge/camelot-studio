# The server stack's own values. A standalone run (`docker compose up -d` in
# this directory) reads this file; the whole stack (`deploy/compose.yaml`) reads
# `deploy/.env`, which carries the same names.

# The environment's name, as `project.json` declares it and the checkout's
# `machine.json` maps it.
CAMELOT_ENVIRONMENT=production

# The shard's name, as the client's server list shows it.
CAMELOT_SHARD_NAME=Camelot Hills
CAMELOT_SHARD_SHORT=CAMELOT

# --- the database --------------------------------------------------------------
# The password of MySQL's `root`; the emulator connects as root, as it does
# everywhere else. The database name must be the same one the checkout's
# `machine.json` names (`environments.<env>.database`).
CAMELOT_DB_PASSWORD=change-me
CAMELOT_DB_NAME=forge_project_production
CAMELOT_DB_PORT=3307

# --- the game server -----------------------------------------------------------
CAMELOT_GAME_PORT=10300
CAMELOT_REGION_PORT=10400
CAMELOT_CORE_CPU=4
# Where the server's own logs land, relative to this directory.
CAMELOT_CORE_LOG_DIR=./data/logs
# Uncomment to move the emulator: pull the tag, read its digest, pin it.
#   podman pull ghcr.io/opendaoc/opendaoc-core:latest
#   podman inspect --format '{{index .RepoDigests 0}}' ghcr.io/opendaoc/opendaoc-core:latest
#CAMELOT_CORE_IMAGE=ghcr.io/opendaoc/opendaoc-core@sha256:…

# --- what the job reads --------------------------------------------------------
# The environment folder (the Installer's `server/camelot/` lives inside it).
CAMELOT_SERVER_ENV=/srv/forge/env
# The checkout of the `camelot-deploy` branch: the project this job reads.
CAMELOT_DEPLOY_CHECKOUT=/srv/forge/deploy
# OpenDAoC's database checkout, for `env provision`.
CAMELOT_BASELINE_SOURCE=/srv/forge/OpenDAoC-Database/opendaoc-db-core

# --- the release signature -----------------------------------------------------
# The operator's public key, for the fallback pull (D §D7). The directory that
# holds it is mounted at /keys, so this is the path inside the container. With
# it, a pull refuses a release whose signature does not check out; empty means
# nothing is checked, and the pull says so.
CAMELOT_KEYS_DIR=/srv/forge/keys
CAMELOT_RELEASE_KEY=/keys/camelot-release.pub
