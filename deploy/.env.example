# The whole server stack's values (`deploy/compose.yaml`). One file: every
# container reads from it, and each part's own `.env.example` documents the same
# names for a standalone run.
#
# Local and online differ by three values — CAMELOT_FEED_URL, CAMELOT_GAME_SERVER
# and the secrets — and by nothing else. The paths below are the ones a VPS uses;
# a desk testing the same stack points them at its own folders.

# --- the shard -----------------------------------------------------------------
# The environment's name, as `project.json` declares it.
CAMELOT_ENVIRONMENT=production
CAMELOT_SHARD_NAME=Camelot Hills
CAMELOT_SHARD_SHORT=CAMELOT

# --- the database --------------------------------------------------------------
# MySQL's root password, and the environment's database. The name must be the one
# the checkout's `machine.json` names (`environments.<env>.database`).
CAMELOT_DB_PASSWORD=change-me
CAMELOT_DB_NAME=camelot_hills_production
CAMELOT_DB_PORT=3307

# --- the game server -----------------------------------------------------------
CAMELOT_GAME_PORT=10300
CAMELOT_REGION_PORT=10400
CAMELOT_CORE_CPU=4
# Where the server's own logs land, relative to `server/`.
CAMELOT_CORE_LOG_DIR=./data/logs
# Uncomment to move the emulator: pull the tag, read its digest, pin it.
#   podman pull ghcr.io/opendaoc/opendaoc-core:latest
#   podman inspect --format '{{index .RepoDigests 0}}' ghcr.io/opendaoc/opendaoc-core:latest
#CAMELOT_CORE_IMAGE=ghcr.io/opendaoc/opendaoc-core@sha256:…

# --- what the server reads and writes ------------------------------------------
# The environment folder. Only `server/camelot/` inside it is ever written.
CAMELOT_SERVER_ENV=/srv/forge/env
# The checkout of the `camelot-deploy` branch (the Console pulls it, the job reads it).
CAMELOT_DEPLOY_CHECKOUT=/srv/forge/deploy
# OpenDAoC's database checkout, for `env provision`.
CAMELOT_BASELINE_SOURCE=/srv/forge/OpenDAoC-Database/opendaoc-db-core
# The directory the feed service serves. The Console's pull mirrors the pulled
# feed into it — same host path, two mounts.
CAMELOT_FEED_SOURCE=/srv/forge/feed

# --- the players' feed ---------------------------------------------------------
# What the players read. The feed on disk is URL-agnostic: the service rewrites
# these two on the way out, so the same files work locally and online.
CAMELOT_FEED_URL=https://patch.example/
CAMELOT_GAME_SERVER=play.example:10300
CAMELOT_FEED_PORT=8080

# --- the Console ---------------------------------------------------------------
CAMELOT_CONSOLE_PASSWORD=change-me
# The same environment name as CAMELOT_ENVIRONMENT: the page shows it.
CAMELOT_CONSOLE_ENV=production
CAMELOT_CONSOLE_HOST=127.0.0.1
CAMELOT_CONSOLE_PORT=8770
# The game server's API: `atlas_api` must be true (`deploy/server/README.md`).
CAMELOT_CONSOLE_API_URL=http://127.0.0.1:5000
CAMELOT_API_PASSWORD=change-me
# Install update and Restart are off unless this is 1. They need a supervisor:
# `core` runs with `restart: unless-stopped`.
CAMELOT_CONSOLE_ALLOW_RESTART=1
CAMELOT_CONSOLE_DEPLOY_REMOTE=origin
CAMELOT_CONSOLE_AUDIT_SOURCE=./data/audit
