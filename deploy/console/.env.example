# The environment folder: client/ and server/ (the Installer's state lives in
# server/camelot/). Mounted read-only.
CAMELOT_SERVER_ENV=/home/me/daoc/forge-env-production

# The environment's name in the project's deploy/log.jsonl. Without it the
# Console cannot say whether a reload was recorded; it says so.
CAMELOT_CONSOLE_ENV=production

# The Console's own credential. Public listeners require it.
CAMELOT_CONSOLE_PASSWORD=change-me

# Where the Console binds. 127.0.0.1 behind a reverse proxy; 0.0.0.0 only with
# a firewall and the password above.
CAMELOT_CONSOLE_HOST=127.0.0.1
CAMELOT_CONSOLE_PORT=8770

# The game's address. With host networking this is the host's own loopback.
CAMELOT_GAME_SERVER=127.0.0.1:10300

# OpenDAoC's read API (server property atlas_api=true). Required for the
# Restart action; optional for the player counts.
CAMELOT_CONSOLE_API_URL=http://127.0.0.1:5000
CAMELOT_API_PASSWORD=

# Actions: 1 turns on Restart (GET /utils/shutdown; the supervisor must start
# the server again). 0 keeps the Console read-only, which is the default.
CAMELOT_CONSOLE_ALLOW_RESTART=0

# The pull (D §D4): the checkout of the deploy branch on this host (a clone of
# the `camelot-deploy` branch), the git remote it fetches, and the directory
# the feed service serves (the same path as CAMELOT_FEED_SOURCE).
CAMELOT_DEPLOY_CHECKOUT=/srv/forge/deploy
CAMELOT_CONSOLE_DEPLOY_REMOTE=origin
CAMELOT_FEED_SOURCE=/srv/forge/feed

# The audit log is written here (the container path is /audit/audit.jsonl).
# The directory is created on the host if it does not exist.
CAMELOT_CONSOLE_AUDIT_SOURCE=./audit

# Optional: mount the project (for deploy/log.jsonl) and the feed. Uncomment
# the two volumes in compose.yaml first, then set these.
# CAMELOT_CONSOLE_PROJECT_SOURCE=/home/me/daoc/forge-project
# CAMELOT_FEED_SOURCE=/home/me/daoc/forge-project/feed
