# The server install's values. `install.sh` generates the three passwords; the
# five values that only you can provide are marked FILL.
#
# Public URLs end with `/`. The game address is what the launcher receives.

# --- the shard -----------------------------------------------------------------
CAMELOT_ENVIRONMENT=production
CAMELOT_SHARD_NAME=Camelot Hills
CAMELOT_SHARD_SHORT=CAMELOT

# --- the project's content repo (FILL) -----------------------------------------
# The branch `camelot-deploy` must already exist: publish from the desk first.
CAMELOT_DEPLOY_REPO=FILL
# The private half of a read-only deploy key, base64 on one line:
#   base64 < deploy_key | tr -d '\n'
CAMELOT_DEPLOY_KEY_B64=FILL
# The desk's release public key, one line: `ssh-ed25519 AAAA... you@desk`.
CAMELOT_RELEASE_PUBLIC_KEY=FILL
# OpenDAoC's complete database, cloned once into the baseline volume.
CAMELOT_BASELINE_REPO=https://github.com/OpenDAoC/OpenDAoC-Database.git

# --- the database ---------------------------------------------------------------
CAMELOT_DB_NAME=camelot_hills_production
CAMELOT_DB_PASSWORD=change-me
CAMELOT_DB_PORT=3307

# --- the game -------------------------------------------------------------------
CAMELOT_GAME_PORT=10300
CAMELOT_REGION_PORT=10400
CAMELOT_CORE_CPU=4
# OpenDAoC's own version: move the digest deliberately (their releases are
# frequent; Watchtower would interrupt play).
CAMELOT_CORE_IMAGE=ghcr.io/opendaoc/opendaoc-core@sha256:89da37855ab3629273884652b646f3bc2a84398193926646d6721341a58d0d3e

# --- the players' feed (FILL) ---------------------------------------------------
CAMELOT_FEED_URL=FILL
CAMELOT_GAME_SERVER=FILL
# The feed listens on 8080 inside its container. Coolify's proxy reaches it on
# the compose network; a host proxy on a bare VPS needs a compose override with
# a `ports` mapping.

# --- the Console ----------------------------------------------------------------
CAMELOT_CONSOLE_PASSWORD=change-me
CAMELOT_CONSOLE_HOST=127.0.0.1
CAMELOT_CONSOLE_PORT=8770
CAMELOT_CONSOLE_GAME_SERVER=127.0.0.1:10300
CAMELOT_CONSOLE_API_URL=http://127.0.0.1:5000
CAMELOT_API_PASSWORD=change-me
CAMELOT_CONSOLE_ALLOW_RESTART=1
